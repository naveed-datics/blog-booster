# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# .env.local is gitignored and used by the app (lib/db.js, lib/auth.js, migrations).

# --- Core (required) ---
# PostgreSQL connection string (SSL enabled in lib/db.js)
DATABASE_URL=

# NextAuth session encryption — generate with: openssl rand -base64 32
# Auth.js v5 accepts AUTH_SECRET; NEXTAUTH_SECRET is also supported
AUTH_SECRET=
NEXTAUTH_SECRET=

# App URL for NextAuth (optional on Vercel — inferred from VERCEL_URL)
# Set to your production domain, e.g. https://your-app.vercel.app
AUTH_URL=
NEXTAUTH_URL=http://localhost:3000

# Public base URL for internal API callbacks
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- OpenAI (use OPENAI_API_KEY OR all AZURE_OPENAI_* variables) ---
OPENAI_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
# Optional; defaults to 2024-12-01-preview in code
AZURE_OPENAI_API_VERSION=

# --- Humanize API ---
HUMANIZE_OPENAI_API_KEY=
# Optional; defaults to https://models.github.ai/inference in code
HUMANIZE_OPENAI_BASE_URL=

# --- Search / trends ---
SERPAPI_KEY=
GEMINI_API_KEY=
# Fallback if GEMINI_API_KEY is unset
GOOGLE_API_KEY=

# --- Google Search Console OAuth (optional if configured in app UI) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/search-console/callback

# --- WordPress publishing ---
WP_BASE_URL=
# Basic auth header, e.g. Basic base64(user:password)
WP_AUTH_HEADER=

# Optional; dev server port (default 3000)
PORT=
