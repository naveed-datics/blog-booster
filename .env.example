# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# IMPORTANT: most configuration no longer lives here.
#
# API keys and pipeline settings are stored in the `app_settings` database
# table and managed from the Settings page in the app (/settings), so they can
# be rotated without a redeploy. Only the bootstrap values below stay in the
# environment, because they are needed before any database query can run.
#
# First-time setup:
#   1. Fill in the bootstrap values below.
#   2. npm run migrate:app-settings      # creates the app_settings table
#   3. npm run settings:import-env       # optional: copies any legacy keys
#                                        # still present here into the table
#   4. Open /settings and fill in the rest.

# --- Bootstrap (must stay in the environment) ---

# PostgreSQL connection string (SSL enabled in lib/db.js).
# Cannot live in app_settings: that table is inside this database.
DATABASE_URL=

# NextAuth session encryption - generate with: openssl rand -base64 32
# Cannot live in app_settings: Auth.js reads it at module load.
# Auth.js v5 accepts AUTH_SECRET; NEXTAUTH_SECRET is also supported.
AUTH_SECRET=
NEXTAUTH_SECRET=

# App URL for NextAuth (optional on Vercel - inferred from VERCEL_URL).
AUTH_URL=
NEXTAUTH_URL=http://localhost:3000

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` using the value it
# reads from the Vercel environment, before our code runs - so this must be
# set as an env var there in addition to being saved in Settings. Generate
# with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# Optional; dev server port (default 3000)
PORT=

# --- Everything below is OPTIONAL here ---
# These are read from Settings (/settings) at runtime. Setting them here does
# nothing except let `npm run settings:import-env` seed the database once.
#
#   Claude LLM:  CLAUDE_LLM_API_KEY, CLAUDE_LLM_BASE_URL,
#                CLAUDE_LLM_WEBHOOK_SECRET, CLAUDE_LLM_TIMEOUT_MS
#   Humanize:    HUMANIZE_OPENAI_API_KEY, HUMANIZE_OPENAI_BASE_URL
#   Search:      SERPAPI_KEY, TAVILY_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY
#   WordPress:   WP_BASE_URL, WP_AUTH_HEADER
#   Search Console: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#                   GOOGLE_OAUTH_REDIRECT_URI
#   Pipeline:    CRON_ENABLED, NEXT_PUBLIC_BASE_URL, RECOVERY_MODE,
#                RECOVERY_START_DATE, RECOVERY_MIN_WEEKS,
#                RECOVERY_DAILY_LIMIT, RECOVERY_REFRESH_LIMIT,
#                NORMAL_DAILY_LIMIT, NORMAL_REFRESH_LIMIT,
#                BULK_REMEDIATION_BYPASS_QUOTA
#   IndexNow:    INDEXNOW_KEY, INDEXNOW_HOST
#
# Azure OpenAI (AZURE_OPENAI_*) and OPENAI_API_KEY have been removed.
# Content generation runs on the Claude LLM relay configured in Settings.
